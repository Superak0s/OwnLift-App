{
  "expo": {
    "name": "OwnLift",
    "slug": "ownlift",
    "version": "1.3.0",
    "orientation": "portrait",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "icon": "./assets/adaptive-icon.png",
    "scheme": "ownlift",
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location for supplement reminders.",
          "locationAlwaysPermission": "Allow $(PRODUCT_NAME) to use your location in the background for location-based reminders.",
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location for setting reminder locations.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon-foreground.png",
          "color": "#667eea",
          "androidMode": "default",
          "androidCollapsedTitle": "Supplement Reminder"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos for progress tracking",
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera for progress photos"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#667eea"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      "./plugins/withGradleTuning.js",
      "./plugins/withDebugAppIdSuffix.js",
      "expo-sqlite",
      "expo-image",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "konstantinos-tsiaros",
          "project": "ownlift-app",
          "url": "https://de.sentry.io/"
        }
      ]
    ],
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ownlift.app"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "INTERNET",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_MULTICAST_STATE"
      ],
      "package": "com.ownlift.app"
    },
    "web": {
      "favicon": "./assets/adaptive-icon.png"
    },
    "owner": "superak0s",
    "extra": {
      "eas": {
        "projectId": "f5f558e0-191a-4125-964c-8dd1681007cc"
      }
    }
  }
}
