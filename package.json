{
  "name": "ownlift-app",
  "version": "1.2.1",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:android:apk": "local-expo-build build android --apk --no-sync",
    "build:android:apk:clean": "local-expo-build build android --apk --no-sync --clean",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "sonar:scan": "node -e \"const{execSync}=require('child_process');execSync(`npx @sonar/scan -Dsonar.host.url=http://192.168.10.12:8999 -Dsonar.token=${process.env.SONAR_TOKEN} -Dsonar.projectKey=OwnLift-App -Dsonar.analysisCache.enabled=false`,{stdio:'inherit'})"
  },
  "jest": {
    "preset": "jest-expo",
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov"
    ]
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.13.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.12.0",
    "@types/jest": "29.5.14",
    "babel-plugin-module-resolver": "^5.0.3",
    "expo": "~57.0.11",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.9",
    "expo-contacts": "~57.0.2",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-image-manipulator": "~57.0.8",
    "expo-image-picker": "~57.0.8",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-location": "~57.0.8",
    "expo-navigation-bar": "~57.0.2",
    "expo-notifications": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.10",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-task-manager": "~57.0.8",
    "expo-updates": "~57.0.12",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.3",
    "lucide-react-native": "^1.25.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-chart-kit": "7.0.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pager-view": "8.0.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "react-refresh": "^0.18.0",
    "xlsx": "^0.18.5"
